# ==============================================================================
# QR Print Kiosk (QRLY) - Environment Configuration
# Copy this file to .env.local for Next.js web application
# and to print-agent/.env for the Python agent daemon
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage, Realtime)
# ------------------------------------------------------------------------------
# Public Supabase project URL (used by browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anonymous key (browser client - strictly zero table permissions via RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged Supabase service role key (SERVER ONLY - never expose to browser bundle)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Razorpay Payments (UPI Checkout, Webhooks, Refunds)
# ------------------------------------------------------------------------------
# Razorpay API Key ID (Test key starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_placeholderKeyId
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholderKeyId

# Razorpay API Secret (SERVER ONLY - used for order generation and refunds)
RAZORPAY_KEY_SECRET=placeholderKeySecret

# Razorpay Webhook Secret (SERVER ONLY - used for HMAC SHA-256 signature verification)
# Must match secret entered in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=placeholderWebhookSecret

# ------------------------------------------------------------------------------
# 3. Application & Security Secrets
# ------------------------------------------------------------------------------
# Base URL of the deployed application (used for generating absolute QR code URLs)
APP_BASE_URL=http://localhost:3000

# Cron authorization secret for scheduled background tasks (/api/cron/sweep)
CRON_SECRET=super_secret_cron_token_min_32_characters

# ------------------------------------------------------------------------------
# 4. Print Agent Daemon (Shop PC / Raspberry Pi)
# ------------------------------------------------------------------------------
# URL of the hosted QRLY web API
SERVER_URL=http://localhost:3000

# Unique Bearer API Key generated in shop owner dashboard
AGENT_KEY=agk_live_placeholderAgentApiKey

# Name of the printer as registered in CUPS (Linux) or Windows Print Spooler
PRINTER_NAME=ShopPrinter

# Polling frequency in seconds (default: 3)
POLL_SECONDS=3

# Dry-run mode: if true, saves prepared PDF to ./out instead of sending to spooler
PRINT_DRY_RUN=true

# Temporary working directory for file slicing and grayscale conversion
WORK_DIR=./work

